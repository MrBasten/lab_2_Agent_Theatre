      "kind": "speech",
      "index": 7,
      "voice_id": "ru_RU-irina-medium",
      "start_seconds": 17.741,
      "end_seconds": 20.389
    },
    {
      "speaker": "narrator",
      "text": "динамик на секунду шипит",
