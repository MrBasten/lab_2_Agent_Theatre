      "kind": "direction",
      "index": 8,
      "voice_id": "ru_RU-denis-medium",
      "start_seconds": 20.839,
      "end_seconds": 23.033
    },
    {
      "speaker": "echo",
      "text": "Вер, там холодно? ... Это её «р», да?",
      "act": 1,
      "kind": "speech",
      "index": 9,
      "voice_id": "ru_RU-ruslan-medium",
      "start_seconds": 23.253,
      "end_seconds": 26.283
    },
    {
      "speaker": "narrator",
      "text": "Красная полоска доходит до края. Синяя ждёт.",
