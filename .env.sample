# Yandex Cloud: заполните значения в .env, а не в ноутбуке.
folder_id=
api_key=
LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_API_KIND=responses
# Если пусто, используется gpt://<folder_id>/aliceai-llm-flash.
LLM_MODEL=
# Вторая облачная модель необязательна; например MARK_MODEL=yandexgpt-5.1.
MARK_MODEL=
LOCAL_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
LOCAL_DEVICE=auto
# Для RTX 5070 12GB: установить extra quantized; none — обычные BF16/FP32 веса.
LOCAL_QUANTIZATION=nf4
# Необязательно: SHA snapshot для воспроизводимости открытых весов.
LOCAL_MODEL_REVISION=
LLM_TIMEOUT=120
LLM_MAX_ATTEMPTS=3
# Озвучка ElevenLabs. Укажите доступные вашему аккаунту ID голосов.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_VERA=
ELEVENLABS_VOICE_MARK=
ELEVENLABS_VOICE_ECHO=
ELEVENLABS_VOICE_NARRATOR=
